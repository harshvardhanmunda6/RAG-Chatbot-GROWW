# LLM_PROVIDER is optional; config.yaml defaults to groq.
# Set LLM_MODEL to an exact model ID available in your provider console.
# With no key/model, the assistant uses deterministic extractive answers.
LLM_PROVIDER=groq
LLM_MODEL=

GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
